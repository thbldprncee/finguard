' Shared look for every diagram: one font, one palette, no bold.
!$fill = "#EAF1FB"
!$border = "#3D6DB5"
!$line = "#3A3A3A"

skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultFontStyle plain
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor $line
skinparam ArrowFontColor #222222
skinparam ArrowThickness 1.1
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #C9B458
skinparam LegendBackgroundColor #FFFBE6
skinparam LegendBorderColor #C9B458

skinparam state {
  BackgroundColor $fill
  BorderColor $border
  FontStyle plain
  AttributeFontStyle plain
  StartColor $line
  EndColor $line
}
skinparam usecase {
  BackgroundColor $fill
  BorderColor $border
}
skinparam actor {
  BackgroundColor $fill
  BorderColor $border
}
skinparam rectangle {
  BorderColor $border
  FontStyle plain
}
skinparam class {
  BackgroundColor $fill
  BorderColor $border
  HeaderBackgroundColor $fill
  FontStyle plain
}
skinparam component {
  BackgroundColor $fill
  BorderColor $border
}
skinparam node {
  BackgroundColor $fill
  BorderColor $border
}
skinparam database {
  BackgroundColor $fill
  BorderColor $border
}
skinparam queue {
  BackgroundColor $fill
  BorderColor $border
}
skinparam sequence {
  ParticipantBackgroundColor $fill
  ParticipantBorderColor $border
  ActorBackgroundColor $fill
  ActorBorderColor $border
  DatabaseBackgroundColor $fill
  DatabaseBorderColor $border
  QueueBackgroundColor $fill
  QueueBorderColor $border
  LifeLineBorderColor #8A8A8A
  GroupBorderColor #8A8A8A
  GroupHeaderFontStyle plain
  DividerFontStyle plain
}
skinparam SequenceGroupFontStyle plain
skinparam SequenceGroupHeaderFontStyle plain
hide circle
