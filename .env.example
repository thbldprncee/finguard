# Copy to .env and fill in, or run scripts/generate-env.sh to generate random values.
# Use alphanumeric passwords: Kafka SCRAM config does not escape special characters.

# Keycloak is served under <FINGUARD_PUBLIC_URL>/auth; tokens are issued for this URL.
FINGUARD_PUBLIC_URL=http://localhost:3000
# Keycloak refuses plain HTTP from non-private addresses unless this is "none".
# Local HTTP only; use "external" (the default) once the site is served over HTTPS.
KEYCLOAK_SSL_REQUIRED=none

# Keycloak admin console (master realm) - only on http://127.0.0.1:8180/auth/admin
KEYCLOAK_ADMIN_PASSWORD=
# Administrator of the finguard realm (application role ADMIN), password at least 12 characters
FINGUARD_ADMIN_EMAIL=admin@finguard.local
FINGUARD_ADMIN_PASSWORD=

POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
TXN_DB_PASSWORD=
FRAUD_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
AUDIT_DB_PASSWORD=

REDIS_PASSWORD=

KAFKA_ADMIN_PASSWORD=
KAFKA_TXN_PASSWORD=
KAFKA_FRAUD_PASSWORD=
KAFKA_NOTIFICATION_PASSWORD=
KAFKA_AUDIT_PASSWORD=
KAFKA_GATEWAY_PASSWORD=
